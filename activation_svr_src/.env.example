# Example environment configuration for the activation server

# License provider to use (currently supports: lemonsqueezy)
LICENSE_PROVIDER=lemonsqueezy

# Lemon Squeezy API configuration
# LEMON_SQUEEZY_API_KEY=your-api-key-here

# Server configuration
PORT=8080

# For deployment on Fly.io, you can set these as secrets:
# fly secrets set LICENSE_PROVIDER=lemonsqueezy
# fly secrets set LEMON_SQUEEZY_API_KEY=your-api-key-here

# Example for switching to a different provider in the future:
# LICENSE_PROVIDER=newprovider
# NEW_PROVIDER_API_KEY=your-new-provider-key
# NEW_PROVIDER_STORE_ID=12345
